{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcbill:dispatch-event:v1",
  "title": "Notification dispatch event",
  "description": "Target Kafka contract, not a live producer. UTF-8 serialized size <= 8192 bytes. Key is notificationId; topology-v1 partition is logicalSlot modulo 2048. All fields must be checked against PG state before durable handoff. No body, credentials or caller-supplied identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "notificationId", "logicalSlot", "scheduleEpoch", "destinationId", "createdAt", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "notificationId": {"type": "string", "format": "uuid"},
    "logicalSlot": {"type": "integer", "minimum": 0, "maximum": 4095},
    "scheduleEpoch": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "destinationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
